{
  "name": "vaulthunter",
  "version": "0.1.0",
  "private": true,
  "description": "Aave V3 liquidation trading bot and keeper infrastructure",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "npm run test && tsc -p tsconfig.json && npm run audit:summary",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "rpc:check": "tsx src/rpc-check.ts",
    "aave:scan": "tsx src/aave/scan.ts",
    "aave:index:once": "tsx src/aave/indexer-cli.ts --once",
    "aave:index": "tsx src/aave/indexer-cli.ts",
    "audit:summary": "node scripts/audit-summary.mjs",
    "chains:check": "tsx src/chain/check-cli.ts",
    "morpho:index:once": "tsx src/morpho/indexer-cli.ts --once",
    "morpho:index": "tsx src/morpho/indexer-cli.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pino": "^9.6.0",
    "zod": "^4.6.7",
    "ethers": "^6.13.5",
    "better-sqlite3": "^11.8.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^5.1.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/pg": "^8.11.11"
  }
}
