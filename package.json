{
  "name": "vaulthunter",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only DeFi liquidation and keeper intelligence foundation",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "rpc:check": "tsx src/index.ts",
    "aave:scan": "tsx src/aave/scan.ts",
    "aave:index:once": "tsx src/aave/indexer-cli.ts --once",
    "aave:index": "tsx src/aave/indexer-cli.ts",
    "morpho:scan:once": "tsx src/morpho/scan.ts --once",
    "morpho:scan": "tsx src/morpho/scan.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pino": "^9.6.0",
    "zod": "^4.6.7",
    "ethers": "^6.13.5",
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "@types/better-sqlite3": "^7.6.12"
  }
}
