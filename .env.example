NODE_ENV=development
LOG_LEVEL=info
PORT=3000
ETHEREUM_RPC_URL=
# Optional durable hosted storage. If unset, local SQLite is used.
DATABASE_URL=
AAVE_SCAN_LOOKBACK_BLOCKS=100
# Keep disabled on hosted services until DATABASE_URL is configured.
AAVE_INDEXER_ENABLED=false
# Aave V3 Ethereum Pool proxy deployment/start block (Ethereum mainnet).
AAVE_INDEXER_START_BLOCK=16291127
AAVE_INDEXER_CONFIRMATIONS=12
AAVE_INDEXER_BATCH_BLOCKS=10
AAVE_INDEXER_POLL_INTERVAL_MS=30000
AAVE_INDEXER_SNAPSHOT_BATCH_SIZE=100
VAULTHUNTER_DB_PATH=./data/vaulthunter.sqlite
# Read-only milestone: execution must remain disabled.
VAULTHUNTER_EXECUTION_ENABLED=false
