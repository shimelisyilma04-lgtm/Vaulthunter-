NODE_ENV=development
LOG_LEVEL=info
PORT=3000
ETHEREUM_RPC_URL=
AAVE_SCAN_LOOKBACK_BLOCKS=100
# Aave V3 Ethereum Pool proxy deployment/start block (Ethereum mainnet).
AAVE_INDEXER_START_BLOCK=16291127
AAVE_INDEXER_CONFIRMATIONS=12
AAVE_INDEXER_BATCH_BLOCKS=10 # increase only if your RPC provider supports larger eth_getLogs ranges
AAVE_INDEXER_POLL_INTERVAL_MS=30000
AAVE_INDEXER_SNAPSHOT_BATCH_SIZE=100
VAULTHUNTER_DB_PATH=./data/vaulthunter.sqlite
MORPHO_MAX_MARKETS=1000
MORPHO_INDEXER_BATCH_BLOCKS=10
MORPHO_INDEXER_MAX_BATCHES_PER_PASS=100
MORPHO_CONFIRMATIONS=12
MORPHO_SNAPSHOT_BATCH_SIZE=10
MORPHO_MARKETS_TO_REFRESH_PER_PASS=25
MORPHO_POLL_INTERVAL_MS=30000
# Read-only milestone: execution must remain disabled.
VAULTHUNTER_EXECUTION_ENABLED=false
